<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<!DOCTYPE html><html lang="ko"><head><jsp:include page="/WEB-INF/jsp/common/head.jsp"><jsp:param name="dsTitle" value="DevSync Admin - 시스템 공지"/></jsp:include></head><body class="ds-body min-h-screen flex"><jsp:include page="/WEB-INF/jsp/common/sidebar.jsp"/><div class="flex-grow flex flex-col min-h-screen"><jsp:include page="/WEB-INF/jsp/common/header.jsp"><jsp:param name="dsPageTitle" value="시스템 공지"/></jsp:include><main class="ds-page"><div class="ds-page-head"><div><h1 class="ds-page-title">시스템 공지사항</h1><p class="ds-page-desc">서비스 점검·재기동 등 전체 회사에 노출할 시스템 공지를 등록합니다.</p></div></div>
<section class="ds-card ds-card-inner ds-mb-20"><input type="hidden" id="noticeSn"><div class="ds-form-12"><div class="ds-field ds-col-9"><label>제목</label><input id="noticeTitle" class="ds-input" maxlength="300"></div><div class="ds-field ds-col-3"><label>팝업 노출</label><select id="popupYn" class="ds-select"><option value="Y">노출</option><option value="N">게시판만</option></select></div><div class="ds-field ds-col-12"><label>내용</label><textarea id="noticeCn" class="ds-textarea" rows="7"></textarea></div></div><div class="ds-form-actions"><button class="ds-btn ds-btn-outline" type="button" onclick="resetNotice()">초기화</button><button class="ds-btn ds-btn-primary" type="button" onclick="saveNotice()">저장</button></div></section>
<section class="ds-card ds-card-inner"><div class="ds-table-wrap"><table class="ds-table"><thead><tr><th>등록일</th><th>제목</th><th>등록자</th><th>팝업</th><th>관리</th></tr></thead><tbody><c:forEach items="${list}" var="r"><tr><td>${r.REG_DT}</td><td><c:out value="${r.NOTICE_TITLE}"/></td><td><c:out value="${r.RGTR_NM}"/></td><td>${r.POPUP_YN}</td><td><button type="button" class="ds-mini-btn" data-sn="${r.NOTICE_SN}" data-title='<c:out value="${r.NOTICE_TITLE}"/>' data-cn='<c:out value="${r.NOTICE_CN}"/>' data-popup="${r.POPUP_YN}" onclick="editNotice(this)">수정</button> <button type="button" class="ds-mini-btn ds-mini-btn-danger" onclick="deleteNotice(${r.NOTICE_SN})">삭제</button></td></tr></c:forEach><c:if test="${empty list}"><tr><td colspan="5" class="ds-empty">시스템 공지가 없습니다.</td></tr></c:if></tbody></table></div></section></main></div>
<script>var ctxPath='${pageContext.request.contextPath}';function resetNotice(){document.getElementById('noticeSn').value='';document.getElementById('noticeTitle').value='';document.getElementById('noticeCn').value='';document.getElementById('popupYn').value='Y';}function editNotice(b){noticeSn.value=b.dataset.sn;noticeTitle.value=b.dataset.title;noticeCn.value=b.dataset.cn;popupYn.value=b.dataset.popup;window.scrollTo(0,0);}function saveNotice(){if(!noticeTitle.value.trim()||!noticeCn.value.trim())return alert('제목과 내용을 입력하십시오.');$.post(ctxPath+'/admin/systemNoticeSave.ajax',{noticeSn:noticeSn.value,noticeTitle:noticeTitle.value,noticeCn:noticeCn.value,popupYn:popupYn.value},function(r){if(r.result==='OK')location.reload();else alert(r.msg||'저장 실패');},'json');}function deleteNotice(sn){if(!confirm('삭제하시겠습니까?'))return;$.post(ctxPath+'/admin/systemNoticeDelete.ajax',{noticeSn:sn},function(r){if(r.result==='OK')location.reload();else alert(r.msg||'삭제 실패');},'json');}</script></body></html>
